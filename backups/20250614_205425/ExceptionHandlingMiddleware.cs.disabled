using Microsoft.AspNetCore.Diagnostics;
using System.Diagnostics;
using System.Net;
using System.Text.Json;

namespace Mcp.CodeReview.Infrastructure;

public class ExceptionHandlingMiddleware
{
    private readonly RequestDelegate _next;
    private readonly ILogger<ExceptionHandlingMiddleware> _logger;
    private readonly IWebHostEnvironment _environment;

    public ExceptionHandlingMiddleware(
        RequestDelegate next, 
        ILogger<ExceptionHandlingMiddleware> logger,
        IWebHostEnvironment environment)
    {
        _next = next;
        _logger = logger;
        _environment = environment;
    }

    public async Task InvokeAsync(HttpContext context)
    {
        try
        {
            await _next(context);
        }
        catch (Exception ex)
        {
            await HandleExceptionAsync(context, ex);
        }
    }

    private async Task HandleExceptionAsync(HttpContext context, Exception exception)
    {
        var traceId = Activity.Current?.Id ?? context.TraceIdentifier;
        var isDevelopment = _environment.IsDevelopment();
        var isStaging = _environment.IsStaging();
        var includeDetails = isDevelopment || isStaging;

        // Log with enriched context
        using (_logger.BeginScope(new Dictionary<string, object>
        {
            ["TraceId"] = traceId,
            ["RequestPath"] = context.Request.Path,
            ["RequestMethod"] = context.Request.Method,
            ["RemoteIP"] = context.Connection.RemoteIpAddress?.ToString() ?? "unknown",
            ["UserAgent"] = context.Request.Headers.UserAgent.ToString(),
            ["ExceptionType"] = exception.GetType().Name,
            ["StackTrace"] = exception.StackTrace ?? "No stack trace available"
        }))
        {
            _logger.LogError(exception, 
                "Unhandled exception occurred. TraceId: {TraceId}, Path: {Path}, Method: {Method}",
                traceId, context.Request.Path, context.Request.Method);
        }

        var response = context.Response;
        response.ContentType = "application/json";

        var (statusCode, title, detail) = GetErrorDetails(exception, includeDetails);
        response.StatusCode = (int)statusCode;

        var errorResponse = new ErrorResponse
        {
            Type = "https://tools.ietf.org/html/rfc7231#section-6.5.1",
            Title = title,
            Status = (int)statusCode,
            Detail = detail,
            Instance = context.Request.Path,
            TraceId = traceId,
            Timestamp = DateTimeOffset.UtcNow
        };

        if (includeDetails)
        {
            errorResponse.DeveloperInfo = new DeveloperErrorInfo
            {
                ExceptionType = exception.GetType().FullName!,
                Message = exception.Message,
                StackTrace = exception.StackTrace,
                InnerException = GetInnerExceptionInfo(exception.InnerException),
                Data = exception.Data.Count > 0 ? 
                    exception.Data.Cast<System.Collections.DictionaryEntry>()
                        .ToDictionary(x => x.Key.ToString()!, x => x.Value?.ToString()) : null
            };
        }

        var jsonResponse = JsonSerializer.Serialize(errorResponse, new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
            WriteIndented = includeDetails
        });

        await response.WriteAsync(jsonResponse);
    }

    private static (HttpStatusCode statusCode, string title, string detail) GetErrorDetails(
        Exception exception, bool includeDetails)
    {
        return exception switch
        {
            ArgumentException => (HttpStatusCode.BadRequest, "Bad Request", 
                includeDetails ? exception.Message : "Invalid request parameters"),
            ArgumentNullException => (HttpStatusCode.BadRequest, "Bad Request", 
                includeDetails ? exception.Message : "Required parameter is missing"),
            UnauthorizedAccessException => (HttpStatusCode.Unauthorized, "Unauthorized", 
                includeDetails ? exception.Message : "Authentication required"),
            InvalidOperationException => (HttpStatusCode.BadRequest, "Bad Request", 
                includeDetails ? exception.Message : "Invalid operation"),
            NotImplementedException => (HttpStatusCode.NotImplemented, "Not Implemented", 
                includeDetails ? exception.Message : "Feature not implemented"),
            TimeoutException => (HttpStatusCode.RequestTimeout, "Request Timeout", 
                includeDetails ? exception.Message : "Request timed out"),
            _ => (HttpStatusCode.InternalServerError, "Internal Server Error", 
                includeDetails ? exception.Message : "An unexpected error occurred")
        };
    }

    private static InnerExceptionInfo? GetInnerExceptionInfo(Exception? innerException)
    {
        if (innerException == null) return null;

        return new InnerExceptionInfo
        {
            Type = innerException.GetType().FullName!,
            Message = innerException.Message,
            StackTrace = innerException.StackTrace,
            InnerException = GetInnerExceptionInfo(innerException.InnerException)
        };
    }
}

public class ErrorResponse
{
    public string Type { get; set; } = string.Empty;
    public string Title { get; set; } = string.Empty;
    public int Status { get; set; }
    public string Detail { get; set; } = string.Empty;
    public string Instance { get; set; } = string.Empty;
    public string TraceId { get; set; } = string.Empty;
    public DateTimeOffset Timestamp { get; set; }
    public DeveloperErrorInfo? DeveloperInfo { get; set; }
}

public class DeveloperErrorInfo
{
    public string ExceptionType { get; set; } = string.Empty;
    public string Message { get; set; } = string.Empty;
    public string? StackTrace { get; set; }
    public InnerExceptionInfo? InnerException { get; set; }
    public Dictionary<string, string?>? Data { get; set; }
}

public class InnerExceptionInfo
{
    public string Type { get; set; } = string.Empty;
    public string Message { get; set; } = string.Empty;
    public string? StackTrace { get; set; }
    public InnerExceptionInfo? InnerException { get; set; }
}