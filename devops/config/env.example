# MCP Code Review Environment Configuration

# =============================================================================
# API Keys and Authentication
# =============================================================================
CLAUDE_API_KEY=your_claude_api_key_here
GITHUB_TOKEN=your_github_token_here
GITLAB_TOKEN=your_gitlab_token_here

# For OpenAI embeddings (optional - can use Claude API key)
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# Database Passwords
# =============================================================================
GITLAB_POSTGRES_PASSWORD=SecureGitLabDBPass123!
SONAR_POSTGRES_PASSWORD=SecureSonarDBPass123!
GITLAB_ROOT_PASSWORD=SecureGitLabPass123!

# =============================================================================
# Monitoring and Security
# =============================================================================
GRAFANA_ADMIN_PASSWORD=SecureGrafanaPass123!
GRAFANA_SECRET_KEY=grafana-secret-key-change-me
SENTRY_DSN=your_sentry_dsn_here

# =============================================================================
# Application Settings
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
ELASTICSEARCH_URL=http://elasticsearch:9200
GITLAB_HOST=http://gitlab:80

# =============================================================================
# RAG Configuration (ChromaDB + Embeddings)
# =============================================================================
CHROMADB_URL=http://chromadb:8000
CHROMADB_AUTH_TOKEN=test-token

# OpenAI Embedding Configuration
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_TOKENS=8191
OPENAI_BATCH_SIZE=100

# =============================================================================
# Development Settings
# =============================================================================
# Set to true to enable detailed RAG logging
RAG_DEBUG_LOGGING=false

# Set to true to auto-seed RAG data on startup
RAG_AUTO_SEED=true

# Default project ID for RAG data
RAG_DEFAULT_PROJECT_ID=mcp-code-review