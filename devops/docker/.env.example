# GitHub API Token (optional for public repos)
GITHUB_TOKEN=your_github_token_here

# GitLab API Token
GITLAB_TOKEN=your_gitlab_token_here

# Claude API Key (required)
CLAUDE_API_KEY=your_claude_api_key_here

# GitLab Host (optional, defaults to https://gitlab.com)
GITLAB_HOST=https://gitlab.com

# Grafana Admin Password (change this!)
GRAFANA_ADMIN_PASSWORD=changeMe123!

# Grafana Secret Key (change this!)
GRAFANA_SECRET_KEY=your-secret-key-here

# Sentry DSN for error tracking (optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Elasticsearch URL for logging (optional, defaults to http://elasticsearch:9200)
ELASTICSEARCH_URL=http://elasticsearch:9200

# Application Environment (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Development