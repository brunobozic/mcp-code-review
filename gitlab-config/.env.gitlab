# GitLab Environment Configuration
# Copy this to .env for docker-compose

# Database Configuration
GITLAB_POSTGRES_PASSWORD=SecureGitLabDBPass123!

# GitLab Configuration
GITLAB_ROOT_PASSWORD=Adm1nP@ssw0rd2025!
GITLAB_ROOT_EMAIL=admin@example.com

# Optional: Customize GitLab hostname
GITLAB_HOSTNAME=gitlab.local

# Optional: External URL if different from default
GITLAB_EXTERNAL_URL=http://localhost:8080

# Security: Change these in production
GITLAB_SECRETS_DB_KEY_BASE=super-secret-key-change-in-production-environment
GITLAB_SECRETS_SECRET_KEY_BASE=another-super-secret-key-change-in-production
GITLAB_SECRETS_OTP_KEY_BASE=otp-secret-key-change-in-production-too

# Optional: SMTP Configuration (uncomment and configure for production)
# GITLAB_SMTP_ENABLE=true
# GITLAB_SMTP_ADDRESS=smtp.gmail.com
# GITLAB_SMTP_PORT=587
# GITLAB_SMTP_USER_NAME=your-email@gmail.com
# GITLAB_SMTP_PASSWORD=your-app-password
# GITLAB_SMTP_DOMAIN=smtp.gmail.com
# GITLAB_SMTP_AUTHENTICATION=login
# GITLAB_SMTP_ENABLE_STARTTLS_AUTO=true
# GITLAB_SMTP_TLS=false

# Optional: Backup Configuration
GITLAB_BACKUP_KEEP_TIME=604800  # 7 days in seconds
GITLAB_BACKUP_CRON=0 2 * * *   # Daily at 2 AM